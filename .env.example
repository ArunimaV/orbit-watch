# Server-only. Never expose this to the browser.
# Leave blank for mock mode: the mic stays off, Brief me still reads the ranker
# out loud as text, and the committed SwissCube render is shown.
# Copy this file to .env.local and set the key from console.x.ai.
XAI_API_KEY=

# Optional. Cesium ion imagery (Phase 2). Leave blank to use Natural Earth II.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Set to 1 to skip CelesTrak and serve the committed fixtures only.
ORBIT_WATCH_OFFLINE=

# Fixture-mode evaluation clock (ISO). Empty uses 2026-10-04T16:00:00Z
# (noon US Eastern, Sunday Oct 4) so SL-8 DEB stays ranked and reads as tonight.
DEMO_NOW=

# Live mission room. Both must be set or the shared room stays off and the
# dashboard looks the same as before. These are public: they only name the
# database, they are not a secret.
# Local server:  NEXT_PUBLIC_SPACETIME_URI=http://127.0.0.1:3100
# Maincloud:     NEXT_PUBLIC_SPACETIME_URI=https://maincloud.spacetimedb.com
# NEXT_PUBLIC_SPACETIME_MODULE=orbit-watch
NEXT_PUBLIC_SPACETIME_URI=
NEXT_PUBLIC_SPACETIME_MODULE=
